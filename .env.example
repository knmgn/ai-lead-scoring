# ==============================================================================
# Enterprise AI Lead Scoring & Enrichment - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Enterprise AI Lead Scoring Engine"
APP_ENV="development" # development | staging | production
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# AI Provider Settings ("openai" or "anthropic")
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# Anthropic (Alternative)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Enrichment Provider (Firecrawl or BeautifulSoup fallback)
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key" # Optional: falls back to direct scraper or mock if empty

# CRM Integration (HubSpot)
HUBSPOT_ACCESS_TOKEN="pat-na1-your-hubspot-token" # Optional: runs in mock/simulation mode if empty
HUBSPOT_PORTAL_ID="12345678"

# Notification Integration (Slack)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX" # Optional: logs block kit if empty
SLACK_MINIMUM_TIER_NOTIFICATION="A" # Notify for tiers S and A (or S, A, B, C)

# Business ICP (Ideal Customer Profile) Context for LLM
TARGET_INDUSTRY="B2B SaaS, FinTech, E-commerce, AI Platforms"
TARGET_EMPLOYEE_MIN=50
TARGET_EMPLOYEE_MAX=5000
TARGET_ANNUAL_REVENUE_MIN="$5M"
COMPANY_PRODUCT_OFFERING="Enterprise Revenue Architecture & Custom AI Sales Automation Pipeline"
